VisualElement {}

#container 
{
	width:100%;
	height:100%;
}

.positionlabelcontainer
{
	height:10%;
	width: 25%;
	margin:2%;
	align-self: flex-start;
	align-content:flex-start;
	flex-direction:row;
}

.positionlabel
{
	width:40%;
	padding:2px;
	border-width:2px;
	border-color:black;
	background-color:black;
	color:white;
	-unity-font-style:bold;
	-unity-text-align:middle-left;
}

